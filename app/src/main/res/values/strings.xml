    <string name="settings_sms_title">SMS transactions</string>
    <string name="settings_sms_explanation">Every inbox SMS is read. Real bank/UPI/card spends and credits are stored as transactions. Offers, remaining card limits, dues and balance-only alerts are marked as not-a-payment and hidden from the list. OTPs, chats and marketing without an amount are skipped.</string>
